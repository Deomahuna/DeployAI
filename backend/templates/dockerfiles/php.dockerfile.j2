FROM php:{{ version }}-cli
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip git curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

COPY . .
RUN {{ install_cmd }}
EXPOSE {{ port }}
CMD [{{ start_cmd_json }}]
